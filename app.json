{
  "expo": {
    "name": "AxMed",
    "slug": "axmed",
    "icon": "./assets/app-icon.png",
    "owner": "axmed-project",
    "extra": {
      "eas": {
        "projectId": "ca415684-7238-461a-bb54-0764d41b6672"
      }
    },
    "version": "1.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "buildNumber": "17",
      "bundleIdentifier": "com.anonymous.pochka2new",
      "appleTeamId": "SAZ93YMRD7",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "AxMed использует Bluetooth для поиска фитнес-браслета и получения измерений с весов.",
        "NSAppleMusicUsageDescription": "Библиотека браслета содержит функции управления музыкой. AxMed не запрашивает доступ к медиатеке, и для функций здоровья он не нужен."
      }
    },
    "android": {
      "package": "com.axmed.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#111111"
      }
    },
    "plugins": [
      "expo-font",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.1067093205466-lt209nb5s2p05dovapkp9u7ac6qspu6l"
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "AxMed использует выбранное фото только для обновления аватара профиля.",
          "cameraPermission": "AxMed использует камеру, чтобы сделать фото профиля.",
          "microphonePermission": false
        }
      ],
      "expo-notifications",
      "./plugins/with-fmdb-system-header",
      "./plugins/with-hband-bitcode-strip",
      "expo-sharing"
    ]
  }
}
