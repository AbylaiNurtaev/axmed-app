{
  "expo": {
    "name": "AxMed",
    "slug": "axmed-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.pochka2new",
      "appleTeamId": "SAZ93YMRD7",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.axmed.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#00a87e"
      }
    },
    "plugins": [
      "expo-font",
      "expo-apple-authentication"
    ]
  }
}
