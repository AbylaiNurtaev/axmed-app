{
  "expo": {
    "name": "AxMed",
    "slug": "axmed-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.pochka2new",
      "appleTeamId": "SAZ93YMRD7",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.axmed.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#00a87e"
      }
    },
    "plugins": [
      "expo-font",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.1067093205466-lt209nb5s2p05dovapkp9u7ac6qspu6l"
        }
      ],
      "expo-secure-store"
    ]
  }
}
