{
  "name": "axmed-mobile",
  "version": "1.0.0",
  "main": "expo/AppEntry",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "devices:test": "node --experimental-strip-types --test tests/device-gateway.test.mjs tests/device-sync.test.mjs tests/scale-mock.test.mjs tests/health-export.test.mjs tests/plan-model.test.mjs",
    "devices:test-build": "node --test tests/fmdb-build-fix.test.cjs",
    "devices:verify-sdk": "node scripts/verify-hband-sdk.mjs",
    "devices:test-native": "node scripts/test-hband-parser.mjs",
    "devices:test-scale": "node scripts/test-lefu-scale-parser.mjs",
    "eas-build-post-install": "node scripts/test-hband-parser.mjs",
    "api:dev": "npm run dev --prefix server",
    "api:start": "npm run start --prefix server",
    "api:typecheck": "npm run typecheck --prefix server",
    "api:test": "npm test --prefix server",
    "api:test:integration": "npm run test:integration --prefix server",
    "api:test:goals": "cd server && node --import tsx --test --test-concurrency=1 --test-force-exit tests/goals.integration.ts",
    "api:test:plan": "cd server && node --import tsx --test --test-concurrency=1 --test-force-exit tests/plan.integration.ts",
    "api:test:profile": "cd server && node --import tsx --test --test-concurrency=1 --test-force-exit tests/profile.integration.ts",
    "api:test:security": "cd server && node --import tsx --test --test-concurrency=1 --test-force-exit tests/security.integration.ts",
    "devices:test-api": "npm run test:devices --prefix server",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "expo": "^57.0.0",
    "expo-apple-authentication": "~57.0.1",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.3",
    "expo-image-manipulator": "~57.0.22",
    "expo-image-picker": "~57.0.17",
    "expo-linear-gradient": "~57.0.1",
    "expo-notifications": "~57.0.25",
    "expo-print": "~57.0.2",
    "expo-secure-store": "~57.0.3",
    "expo-sharing": "~57.0.26",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "typescript": "~6.0.3"
  }
}
