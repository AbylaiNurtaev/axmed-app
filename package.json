    "api:typecheck": "npm run typecheck --prefix server",
    "api:test": "npm test --prefix server",
    "api:test:integration": "npm run test:integration --prefix server",
    "devices:test-api": "npm run test:devices --prefix server",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down"
