# Production template. Add these variables to the axmed-api service in Railway.
# PORT is injected by Railway. Do not copy the local database or development JWT secret.
NODE_ENV=production
HOST=0.0.0.0
TRUST_PROXY_HOPS=1
DATABASE_URL=${{Postgres.DATABASE_URL}}
JWT_SECRET=REPLACE_WITH_A_NEW_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_ISSUER=axmed-api
JWT_AUDIENCE=axmed-mobile
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
VERIFICATION_CODE_TTL_MINUTES=10
AUTH_EXPOSE_DEV_CODE=false
AUTH_FIXED_VERIFICATION_CODE=

# Native iOS/Android requests do not require CORS. If a web app is deployed,
# add its exact HTTPS origin here (comma-separated for multiple origins).
CORS_ORIGIN=

# Public OAuth client identifiers; these are not client secrets.
GOOGLE_CLIENT_IDS=1067093205466-sts78mosd7tm2cafg1vsn9lkk0trj6bi.apps.googleusercontent.com,1067093205466-lt209nb5s2p05dovapkp9u7ac6qspu6l.apps.googleusercontent.com
APPLE_CLIENT_ID=com.anonymous.pochka2new
# Sign in with Apple token revocation when deleting an account.
APPLE_TEAM_ID=SAZ93YMRD7
APPLE_SIGN_IN_KEY_ID=
# The .p8 content, with real newlines or escaped \\n. Keep this secret.
APPLE_SIGN_IN_PRIVATE_KEY=

# Use an HTTPS email API on Railway Free/Trial/Hobby; outbound SMTP is blocked.
# Set one API key. For Resend, EMAIL_FROM requires a verified domain.
# For Brevo, verify the sender address and activate transactional sending.
RESEND_API_KEY=
BREVO_API_KEY=
EMAIL_FROM=

# Optional: profile photo storage. Without these, S3 avatar uploads are unavailable.
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_BUCKET_NAME=
AWS_S3_REGION=
